<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Barcode Scanner View -->
    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/zxing_barcode_scanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_scanner_layout="@layout/custom_barcode_scanner" />

    <!-- Top Overlay -->
    <LinearLayout
        android:id="@+id/topOverlay"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/overlay_gradient_top"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Close Button -->
        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_button_background"
            android:src="@drawable/ic_close"
            android:scaleType="centerInside"
            android:padding="12dp"
            app:tint="#FFFFFF" />

        <!-- Title -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Scan Employee QR Code"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:fontFamily="sans-serif-medium" />

        <!-- Flash Button -->
        <ImageButton
            android:id="@+id/flashButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_button_background"
            android:src="@drawable/ic_flash_off"
            android:scaleType="centerInside"
            android:padding="12dp"
            app:tint="#FFFFFF" />

    </LinearLayout>

    <!-- Bottom Overlay -->
    <LinearLayout
        android:id="@+id/bottomOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/overlay_gradient_bottom"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center">

        <!-- Instruction Text -->
        <TextView
            android:id="@+id/instructionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Position the QR code within the frame\nEnsure good lighting for best results"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textAlignment="center"
            android:lineSpacingExtra="4dp"
            android:fontFamily="sans-serif" />

        <!-- Scanner Guidelines -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="• Hold ID-Card steady\n• Avoid shadows and reflections\n• Move closer if needed"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"
            android:fontFamily="sans-serif" />

    </LinearLayout>

    <!-- Scanning Animation Overlay -->
    <View
        android:id="@+id/scanningLine"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_centerInParent="true"
        android:background="@drawable/scanning_line"
        android:visibility="gone" />

</RelativeLayout>